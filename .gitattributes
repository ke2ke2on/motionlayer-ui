# 줄바꿈 정리: 저장소에는 LF로 두고, 윈도우 전용 파일만 CRLF로 둔다.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.md text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# 바이너리 (줄바꿈 변환 금지)
*.png binary
*.webp binary
*.jpg binary
*.jar binary
*.ttf binary
*.otf binary
